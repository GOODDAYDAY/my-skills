/.claude/

# Ignore all top-level directories by default (local-only skills)
# Manually `git add -f <skill>/` for any new skill you want to track
/*/

# Whitelist: existing tracked skills
!/_shared/
!/create-skill/
!/req/
!/req-amend/
!/req-catalog/
!/req-domain-skills-generate/
!/req-refresh/
!/slidev-practice/
!/write-blog/
!/write-doc/
